# =============================================================================
# REALTIME SERVICE - Environment Configuration Example
# =============================================================================
# Copy this file to .env and update with your values

# Application
MIX_ENV=dev
PORT=4003
PHX_HOST=localhost
PHX_SERVER=true

# Security
SECRET_KEY_BASE=your_secret_key_base_min_64_chars
JWT_SECRET=your_jwt_secret

# MongoDB
MONGODB_URL=mongodb://user:password@localhost:27017/realtime_db?authSource=admin

# Redis
REDIS_URL=redis://:password@localhost:6379

# Kafka
KAFKA_BROKERS=localhost:9092

# Auth Service
AUTH_SERVICE_URL=http://localhost:8081

# WebSocket Configuration
WS_MAX_CONNECTIONS=10000
WS_HEARTBEAT_INTERVAL=30000

# WebRTC ICE Servers
STUN_SERVER_URL=stun:stun.l.google.com:19302
TURN_SERVER_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Erlang Distribution
RELEASE_COOKIE=your_erlang_cookie
NODE_NAME=realtime@localhost

# Observability
JAEGER_ENDPOINT=http://localhost:14268/api/v1/traces
LOG_LEVEL=debug
