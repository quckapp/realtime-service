# =============================================================================
# REALTIME SERVICE - Production Environment
# =============================================================================

# Application
MIX_ENV=prod
PORT=4003
PHX_HOST=quckapp.com
PHX_SERVER=true

# Security
SECRET_KEY_BASE=${SECRET_KEY_BASE}
JWT_SECRET=${JWT_SECRET}

# MongoDB
MONGODB_URL=${MONGODB_URL}

# Redis
REDIS_URL=${REDIS_URL}

# Kafka
KAFKA_BROKERS=${KAFKA_BROKERS}

# Auth Service
AUTH_SERVICE_URL=http://auth-service:8081

# WebSocket Configuration
WS_MAX_CONNECTIONS=100000
WS_HEARTBEAT_INTERVAL=30000
WS_TIMEOUT=60000

# WebRTC ICE Servers
STUN_SERVER_URL=${STUN_SERVER_URL}
TURN_SERVER_URL=${TURN_SERVER_URL}
TURN_USERNAME=${TURN_USERNAME}
TURN_CREDENTIAL=${TURN_CREDENTIAL}

# Erlang Distribution
RELEASE_COOKIE=${ERLANG_COOKIE}
NODE_NAME=realtime@${HOSTNAME}

# Observability
JAEGER_ENDPOINT=${JAEGER_ENDPOINT}
LOG_LEVEL=info

# Feature Flags
ENABLE_METRICS=true
ENABLE_TRACING=true

# Performance
POOL_SIZE=20
